# These belong in TWO places, not a local .env file:
#  - Vercel → this project → Settings → Environment Variables (for the /api/blog/* routes)
#  - GitHub → this repo → Settings → Secrets and variables → Actions (for the weekly draft job)
# See README.md "Blog setup" for the full walkthrough.

# Same Supabase project already used for anything else you run — just two new
# tables (blog_topics, blog_posts) from supabase/blog-schema.sql.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Same Gemini key you already have.
GEMINI_API_KEY=your_gemini_api_key

# Same Resend account you already have.
RESEND_API_KEY=your_resend_api_key
RESEND_FROM_EMAIL=Portfolio Blog <onboarding@resend.dev>

# Where the weekly "review this draft" email is sent. On Resend's free tier
# this MUST be the email address you signed up to Resend with.
NOTIFY_EMAIL=you@example.com

# GitHub Actions only — the deployed site's base URL, used to build the
# approve/reject links in the weekly email.
SITE_URL=https://your-portfolio.vercel.app

# Vercel only — sets the password for /blog-admin.html. Pick your own.
BLOG_ADMIN_PASSWORD=choose_a_password
